---
import "../styles/global.css";
const year = new Date().getFullYear();
import SpeedInsights from "@vercel/speed-insights/astro"
---
<!doctype html>
<html lang="es">
<head>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Víctor Pinero | Desarrollador web full-stack</title>
<meta name="description" content="Desarrollador web full-stack freelance. Creo webs y aplicaciones a medida con PHP, Laravel, React y Next.js, con rendimiento y SEO técnico de serie." />
<link rel="canonical" href="https://victorpinero.dev/" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Víctor Pinero" />
<meta property="og:title" content="Víctor Pinero | Desarrollador web full-stack" />
<meta property="og:description" content="Webs y aplicaciones a medida con PHP, Laravel, React y Next.js." />
<meta property="og:url" content="https://victorpinero.dev/" />
<meta property="og:locale" content="es_ES" />
<meta property="og:image" content="https://victorpinero.dev/og-default.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Webs y apps hechas a medida, por Víctor Pinero" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" /> 
<meta name="theme-color" content="#F4F1EA" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="light dark" />
<meta name="author" content="Víctor Pinero" />
<link rel="me" href="https://github.com/VictorPinero21" />




	</head>
	<body class="grid min-h-screen place-items-center p-6 text-center font-sans">
		<main class="max-w-2xl">
			<h1 class="mb-2 text-[clamp(2rem,5vw,3rem)] font-bold">
				🚧 Este sitio se está creando
			</h1>
			<p class="text-lg leading-[1.6] opacity-[.85]">
				Estoy construyendo mi portfolio de desarrollador web. Pronto podrás ver mis proyectos,
				mis habilidades y cómo contactarme.
			</p>
			<footer class="mt-8 text-sm opacity-60">© {year}</footer>
		</main>
		<SpeedInsights />
	</body>
</html>